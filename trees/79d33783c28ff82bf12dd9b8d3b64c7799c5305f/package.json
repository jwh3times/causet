{
  "name": "@holland-vip/causet",
  "version": "0.19.1",
  "description": "Git-backed causal source control: records how changes move between Git histories, with verifiable receipts, declared provenance, and portable metadata.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwh3times/causet.git"
  },
  "homepage": "https://github.com/jwh3times/causet#readme",
  "bugs": {
    "url": "https://github.com/jwh3times/causet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cst": "./bin/vlab.js",
    "vlab": "./bin/vlab.js"
  },
  "scripts": {
    "build:native": "node ./scripts/build-native.mjs",
    "test": "node --test",
    "test:docs": "node ./scripts/check-doc-links.mjs",
    "demo": "node ./scripts/demo.mjs",
    "demo:clean": "node ./scripts/clean-demo-fixtures.mjs",
    "demo:conflict": "node ./scripts/conflict-demo.mjs",
    "demo:resolution": "node ./scripts/resolution-demo.mjs",
    "demo:forecast": "node ./scripts/forecast-demo.mjs",
    "demo:spec": "node ./scripts/spec-merge-demo.mjs",
    "demo:git-session": "node ./scripts/git-session-demo.mjs",
    "test:benchmark": "node ./scripts/benchmark-regression.mjs",
    "benchmark:record": "node ./scripts/benchmark-regression.mjs --record",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:agents:check": "node scripts/sync-agents.mjs --check",
    "sync:architecture": "node ./scripts/sync-architecture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
