{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.spec-merge-plan/v1",
  "title": "Semantic spec merge plan",
  "description": "Deterministic three-way semantic merge plan for one Markdown specification (CLI output of vlab spec merge-plan --json; src/specs.js planSpecMerge). status 'clean' carries a materializable result; 'blocked' carries the conflicts that prevent it.",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema", "algorithm", "status", "file", "manifestFile", "artifactId",
    "signature", "base", "ours", "theirs", "decisions", "counts", "ordering",
    "conflicts", "result"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.spec-merge-plan/v1" },
    "algorithm": { "const": "stable-markdown-three-way/v1" },
    "status": { "enum": ["clean", "blocked"] },
    "file": { "type": "string", "minLength": 1 },
    "manifestFile": { "type": "string", "minLength": 1 },
    "artifactId": { "type": ["string", "null"] },
    "signature": { "type": ["string", "null"] },
    "revisions": {
      "type": "object",
      "description": "The requested base/ours/theirs revisions. Absent in the artifact-identity-mismatch blocked shape.",
      "properties": {
        "base": { "type": "string" },
        "ours": { "type": "string" },
        "theirs": { "type": "string" }
      }
    },
    "base": { "type": ["object", "null"] },
    "ours": { "type": ["object", "null"] },
    "theirs": { "type": ["object", "null"] },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "counts": {
      "type": "object",
      "description": "Decision or conflict-type counts."
    },
    "ordering": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "type": "string" },
        "order": { "type": "array" }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "result": {
      "type": ["object", "null"],
      "properties": {
        "deleted": { "type": "boolean" },
        "markdown": { "type": "string" },
        "manifest": { "type": "object" },
        "markdownHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "manifestHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
