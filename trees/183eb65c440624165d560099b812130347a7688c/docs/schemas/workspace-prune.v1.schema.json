{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causet.workspace-prune/v1",
  "title": "Workspace prune result",
  "description": "Preview or applied stale-path prune result of vlab workspace prune (CLI output; src/workspaces.js pruneWorkspaces).",
  "x-causet-scope": "cli-output",
  "type": "object",
  "required": ["schema", "dryRun", "applied", "changed", "count", "candidates"],
  "properties": {
    "schema": { "enum": ["causet.workspace-prune/v1", "vcs-lab.workspace-prune/v1"] },
    "dryRun": { "type": "boolean" },
    "applied": { "type": "boolean" },
    "changed": { "type": "boolean" },
    "count": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "compatibilityBranch"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "compatibilityBranch": { "type": "string" }
        }
      }
    }
  }
}
