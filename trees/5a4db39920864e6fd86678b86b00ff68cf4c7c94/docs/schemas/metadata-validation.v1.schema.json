{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causet.metadata-validation/v1",
  "title": "Metadata validation result",
  "description": "Inventory plus strict/non-strict validity result of vlab metadata validate --json (CLI output; src/metadata.js validateMetadata). Identical to causet.metadata-status/v1 except for the schema identifier and the added strict flag; in strict mode warnings also invalidate.",
  "x-causet-scope": "cli-output",
  "type": "object",
  "required": ["schema", "repository", "scopes", "summary", "diagnostics", "trust", "strict"],
  "properties": {
    "schema": { "enum": ["causet.metadata-validation/v1", "vcs-lab.metadata-validation/v1"] },
    "repository": { "$ref": "causet.metadata-status/v1#/$defs/repository" },
    "scopes": { "$ref": "causet.metadata-status/v1#/$defs/scopes" },
    "summary": { "$ref": "causet.metadata-status/v1#/$defs/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "causet.metadata-status/v1#/$defs/diagnostic" }
    },
    "trust": {
      "type": "object",
      "required": ["integrityChecked", "cryptographicallyTrusted", "authorized", "statement"],
      "properties": {
        "integrityChecked": { "const": true },
        "cryptographicallyTrusted": { "const": false },
        "authorized": { "const": false },
        "statement": { "type": "string" }
      }
    },
    "strict": { "type": "boolean" }
  }
}
