{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.metadata-retention/v1",
  "title": "Causal object retention backfill",
  "description": "Preview or application of retention for currently accepted portable facts. Quarantined records are reported and never repaired or retained as accepted evidence. Repeating apply against the same notes snapshot is a no-op. Preview creates no objects or refs. Retention does not grant causal coverage.",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": ["schema", "mode", "notesTip", "retentionBefore", "retentionAfter", "eligibleRecords", "quarantinedRecords", "objects", "wouldChange", "changed", "diagnostics"],
  "properties": {
    "schema": { "const": "vcs-lab.metadata-retention/v1" },
    "mode": { "enum": ["preview", "apply"] },
    "notesTip": { "type": ["string", "null"] },
    "retentionBefore": { "type": ["string", "null"] },
    "retentionAfter": { "type": ["string", "null"] },
    "eligibleRecords": { "type": "integer", "minimum": 0 },
    "quarantinedRecords": { "type": "integer", "minimum": 0 },
    "objects": {
      "type": "object", "required": ["commits", "trees", "blobs"],
      "properties": {
        "commits": { "type": "integer", "minimum": 0 },
        "trees": { "type": "integer", "minimum": 0 },
        "blobs": { "type": "integer", "minimum": 0 }
      }
    },
    "wouldChange": { "type": "boolean" },
    "changed": { "type": "boolean" },
    "diagnostics": { "type": "array", "items": { "$ref": "vcs-lab.metadata-status/v1#/$defs/diagnostic" } }
  }
}
