{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.reconciliation/v6",
  "title": "Reconciliation receipt",
  "description": "Final reconciliation summary with coverage, applications, trees, and timing, attached to the result commit (shared-portable note record; src/operations.js finalizeReconciliation).",
  "x-vcs-lab-scope": "note-record",
  "type": "object",
  "required": [
    "schema", "type", "id", "operationId", "forecastId", "sourceRef",
    "sourceHead", "targetBefore", "resultCommit", "absorbedCommits",
    "absorbedChanges", "applied", "forkedSourceCommits", "targetTreeBefore",
    "sourceTree", "resultTree", "exactStateEqualityBefore",
    "exactStateEqualityAfter", "timings", "startedAt", "createdAt"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.reconciliation/v6" },
    "type": { "const": "reconciliation" },
    "id": { "type": "string", "minLength": 4 },
    "operationId": { "type": "string", "minLength": 1 },
    "forecastId": { "type": ["string", "null"] },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceHead": { "$ref": "#/$defs/oid" },
    "targetBefore": { "$ref": "#/$defs/oid" },
    "resultCommit": {
      "$ref": "#/$defs/oid",
      "description": "The commit this record is attached to; when the record carries attachedTo, both must be equal."
    },
    "absorbedCommits": { "type": "array", "items": { "$ref": "#/$defs/oid" } },
    "absorbedChanges": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceCommit", "appliedCommit", "changeId", "relation",
          "conflictedPaths", "resolutions", "semanticMerges"
        ],
        "properties": {
          "sourceCommit": { "$ref": "#/$defs/oid" },
          "appliedCommit": { "$ref": "#/$defs/oid" },
          "changeId": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "conflictedPaths": { "type": "array", "items": { "type": "string" } },
          "resolutions": { "type": "array" },
          "semanticMerges": { "type": "array" }
        }
      }
    },
    "forkedSourceCommits": { "type": "array", "items": { "$ref": "#/$defs/oid" } },
    "targetTreeBefore": { "$ref": "#/$defs/oid" },
    "sourceTree": { "$ref": "#/$defs/oid" },
    "resultTree": { "$ref": "#/$defs/oid" },
    "exactStateEqualityBefore": { "type": "boolean" },
    "exactStateEqualityAfter": { "type": "boolean" },
    "timings": { "$ref": "#/$defs/operationTimings" },
    "startedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "attachedTo": { "$ref": "#/$defs/oid" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" },
    "operationTimings": {
      "type": "object",
      "description": "Pre-publication operation measurements, not whole-command telemetry. See docs/schemas/receipt-timings.md for the distinct measurement boundaries.",
      "required": ["activeApplicationMs", "elapsedWallMs", "git"],
      "properties": {
        "activeApplicationMs": { "type": "number", "description": "Accumulated active application spans, including successful continuation setup, excluding user pause time and finalization/publication." },
        "elapsedWallMs": { "type": "number", "description": "Wall time from operation.startedAt to receipt construction before publication, including time paused between invocations; not end-to-end command latency." },
        "git": { "type": ["object", "null"], "description": "Accumulated Git metric scopes inside application-queue calls. Excludes planning, continuation work before queue entry, finalization, record/provenance publication, and journal cleanup. Null means unavailable, not zero cost." }
      }
    }
  }
}
