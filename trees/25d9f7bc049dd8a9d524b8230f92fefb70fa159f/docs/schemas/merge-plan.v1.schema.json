{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.merge-plan/v1",
  "title": "Causal merge plan",
  "description": "Source/target coverage plan (CLI output of vlab merge-plan --json; embedded as the plan of forecast and reconciliation records; src/merge-plan.js).",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema",
    "targetHead",
    "sourceRef",
    "sourceHead",
    "targetTree",
    "sourceTree",
    "exactStateEquality",
    "physicalBase",
    "effectiveBase",
    "reachableReceipts",
    "counts",
    "changes"
  ],
  "properties": {
    "schema": {
      "const": "vcs-lab.merge-plan/v1"
    },
    "targetHead": {
      "$ref": "#/$defs/oid"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceHead": {
      "$ref": "#/$defs/oid"
    },
    "targetTree": {
      "$ref": "#/$defs/oid"
    },
    "sourceTree": {
      "$ref": "#/$defs/oid"
    },
    "exactStateEquality": {
      "type": "boolean"
    },
    "physicalBase": {
      "$ref": "#/$defs/oid"
    },
    "effectiveBase": {
      "type": "object",
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/oid"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "reachableReceipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "covered",
        "candidate-equivalent",
        "new"
      ],
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "candidate-equivalent": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "commit",
        "shortCommit",
        "changeId",
        "subject",
        "status",
        "proof",
        "changedPaths"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/oid"
        },
        "shortCommit": {
          "type": "string",
          "minLength": 1
        },
        "changeId": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "enum": [
            "covered",
            "candidate-equivalent",
            "new"
          ]
        },
        "changedPaths": {
          "type": "array",
          "description": "Paths this commit touched, read from the same git log process that builds the queue. The merge-tree forecast engine uses them to detect a nested .gitattributes edit it would otherwise simulate under the wrong attributes (ADR-0016).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proof": {
          "type": [
            "string",
            "null"
          ],
          "description": "Coverage proof, or null for new work: commit-ancestry, receipt-commit, stable-change-id, receipt-change-id, git-patch-id-heuristic. Records written before v0.12.0 may carry signed-shaped-landing-receipt where receipt-commit now appears; nothing branches on the value, so readers pass it through unchanged (docs/schemas/compatibility.md)."
        }
      }
    }
  }
}
