{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causet.workspace/v1",
  "title": "Workspace descriptor",
  "description": "One registered workspace as stored in the causet.workspaces/v1 registry (src/workspaces.js createWorkspace and lifecycle updates). CLI outputs (workspace create/list/move/archive/restore/repair) add inspection projections: lifecycle default, status, pathStatus, head, dirtyFiles, and changed.",
  "x-causet-scope": "shared-local",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "path",
    "compatibilityBranch",
    "target",
    "baseSnapshot",
    "createdAt",
    "owner",
    "focus"
  ],
  "properties": {
    "schema": {
      "enum": ["causet.workspace/v1", "vcs-lab.workspace/v1"]
    },
    "id": {
      "type": "string",
      "pattern": "^ws_[a-z0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityBranch": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "baseSnapshot": {
      "$ref": "#/$defs/oid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "focus": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "enum": [
        "active",
        "archived"
      ],
      "description": "Missing on registries written before lifecycle tracking; readers default it to 'active'."
    },
    "archivedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archiveReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastHead": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    },
    "previousPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "movedAt": {
      "type": "string",
      "format": "date-time"
    },
    "restoredAt": {
      "type": "string",
      "format": "date-time"
    },
    "repairedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cone": {
      "type": [
        "array",
        "null"
      ],
      "description": "Sparse-checkout cone: directory prefixes, relative to the repository root, that this workspace materializes. Null means the whole tree. Optional and additive inside v1 (ADR-0020); distinct from the free-text focus label. Reapplied on restore so an archive/restore cycle does not silently write the whole tree.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    }
  }
}
