{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causet.migration-report/v1",
  "title": "Migration report",
  "description": "Result of cst migrate [--dry-run] --json (CLI output; src/migration.js; ADR-0039 §3). A dry run lists every ref it would create, the configuration it would repoint, the runtime paths it would move and the manifest move it would stage, and changes nothing. A refused run exits non-zero with the error envelope; a refused dry run reports the refusal under `refused`.",
  "x-causet-scope": "cli-output",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "stateBefore",
    "stateAfter",
    "refused",
    "refs",
    "config",
    "paths",
    "specs",
    "summary"
  ],
  "properties": {
    "schema": {
      "enum": [
        "causet.migration-report/v1",
        "vcs-lab.migration-report/v1"
      ]
    },
    "mode": {
      "enum": [
        "dry-run",
        "apply"
      ]
    },
    "stateBefore": {
      "enum": [
        "unmigrated",
        "migrated",
        "fresh"
      ]
    },
    "stateAfter": {
      "enum": [
        "unmigrated",
        "migrated",
        "mixed",
        "fresh"
      ]
    },
    "refused": {
      "type": [
        "object",
        "null"
      ],
      "description": "Null when nothing refused; otherwise the refusal a dry run reports, with the error envelope's code, message and details.",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "oid",
          "action"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "oid": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "present",
              "fast-forward",
              "conflict"
            ]
          }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "from",
          "to",
          "action"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": "string"
          },
          "action": {
            "enum": [
              "repoint",
              "keep"
            ]
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "action"
        ],
        "properties": {
          "from": {
            "type": "string",
            "description": "Relative to the common Git directory."
          },
          "to": {
            "type": "string"
          },
          "action": {
            "enum": [
              "move",
              "present"
            ]
          }
        }
      }
    },
    "specs": {
      "type": "object",
      "required": [
        "from",
        "to",
        "files",
        "action"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "none",
            "move",
            "present"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "refs",
        "config",
        "paths",
        "specs",
        "commitRequired"
      ],
      "properties": {
        "refs": {
          "type": "integer",
          "minimum": 0
        },
        "config": {
          "type": "integer",
          "minimum": 0
        },
        "paths": {
          "type": "integer",
          "minimum": 0
        },
        "specs": {
          "type": "integer",
          "minimum": 0
        },
        "commitRequired": {
          "type": "boolean",
          "description": "True when the manifest move is staged and waits for the user's commit."
        }
      }
    }
  }
}
