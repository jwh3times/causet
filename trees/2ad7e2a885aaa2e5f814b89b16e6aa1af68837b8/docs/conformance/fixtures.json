{
  "schema": "vcs-lab.conformance-fixtures/v1",
  "description": "Human/JSON parity contract for the vlab CLI (FR-GIT-06; ADR-0015 phase 0b, issue #11 item 5). Each command entry names the JSON members its human rendering must present and the members it deliberately does not. test/conformance.test.js runs every entry against the real CLI; see README.md for the match rules and the scenario stages.",
  "commands": [
    {
      "name": "verify-proof",
      "argv": ["verify-proof", "{proofBundle}"],
      "stage": "clean",
      "mode": "reread",
      "note": "Repository verification checks the complete source inventory and bases in addition to evidence; adversarial refusal parity is covered by integration tests.",
      "required": [
        { "pointer": "/bundleSchema", "rule": "exact" },
        { "pointer": "/integrity/intact", "rule": "mapped", "render": { "true": "intact", "false": "BROKEN" } },
        { "pointer": "/classification/counts/agrees", "rule": "mapped", "render": { "true": "counts       agree", "false": "counts       DO NOT AGREE" } },
        { "pointer": "/classification/uniqueCommits", "rule": "mapped", "render": { "true": "unique commits", "false": "DUPLICATE commits" } },
        { "pointer": "/repository/matches", "rule": "mapped", "render": { "true": "matches this repository", "false": "DOES NOT MATCH this repository" } },
        { "pointer": "/trust/statement", "rule": "exact" }
      ],
      "jsonOnly": [
        { "pointer": "/integrity/computed", "reason": "The human report states whether the digest matches; the complete hash remains machine-readable." }
      ]
    },
    {
      "name": "verify-proof-offline",
      "argv": ["verify-proof", "{proofBundle}", "--offline"],
      "stage": "clean",
      "mode": "reread",
      "note": "Offline success cannot establish source completeness, identities, or bases.",
      "required": [
        { "pointer": "/repository/reason", "rule": "exact" },
        { "pointer": "/trust/statement", "rule": "exact" }
      ],
      "jsonOnly": []
    },
    {
      "name": "merge-plan",
      "argv": [
        "merge-plan",
        "plan-source"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "The reconciliation plan is the decision automation acts on: which changes are covered, which are heuristic candidates, and which are new.",
      "required": [
        {
          "pointer": "/targetHead",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/sourceRef",
          "rule": "exact"
        },
        {
          "pointer": "/sourceHead",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/physicalBase",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/effectiveBase/commit",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/effectiveBase/reason",
          "rule": "exact"
        },
        {
          "pointer": "/exactStateEquality",
          "rule": "mapped",
          "render": {
            "true": "same state   yes",
            "false": "same state   no"
          }
        },
        {
          "pointer": "/changes/0/shortCommit",
          "rule": "exact"
        },
        {
          "pointer": "/changes/0/changeId",
          "rule": "exact"
        },
        {
          "pointer": "/changes/0/subject",
          "rule": "exact"
        },
        {
          "pointer": "/changes/0/status",
          "rule": "mapped",
          "render": {
            "covered": "= ",
            "candidate-equivalent": "? ",
            "new": "+ "
          }
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/schema",
          "reason": "The schema identifier is a machine dispatch key; the heading names the plan for a reader."
        },
        {
          "pointer": "/targetTree",
          "reason": "Exact-state tree identity is a machine comparison; the reader is told whether the states match, not which trees."
        },
        {
          "pointer": "/sourceTree",
          "reason": "As targetTree."
        },
        {
          "pointer": "/changes/0/commit",
          "reason": "The reader gets shortCommit; the full OID is the machine form of the same value."
        },
        {
          "pointer": "/changes/0/changedPaths/0",
          "reason": "The paths a change touched are read for the merge-tree engine's nested .gitattributes detection (ADR-0016) and are available to automation; the plan text names the change, not its files."
        }
      ]
    },
    {
      "name": "receipts",
      "argv": [
        "receipts"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "Published causal records. The first record of this scenario is the reconciliation application.",
      "required": [
        {
          "pointer": "/0/id",
          "rule": "exact"
        },
        {
          "pointer": "/0/type",
          "rule": "mapped",
          "render": {
            "application": "APPLICATION"
          }
        },
        {
          "pointer": "/0/relation",
          "rule": "exact"
        },
        {
          "pointer": "/0/appliedCommit",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/0/originCommit",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/0/appliedChangeId",
          "rule": "exact"
        },
        {
          "pointer": "/0/conflictedPaths/0",
          "rule": "exact"
        },
        {
          "pointer": "/0/createdAt",
          "rule": "exact"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/0/schema",
          "reason": "Machine dispatch key; the record heading names the type for a reader."
        },
        {
          "pointer": "/0/targetBefore",
          "reason": "The commit the target was on before applying is recoverable from the application chain and is not part of the reader's decision."
        },
        {
          "pointer": "/0/sourceTree",
          "reason": "Tree identity is a machine equality check."
        },
        {
          "pointer": "/0/resultTree",
          "reason": "As sourceTree."
        },
        {
          "pointer": "/0/reconciliationOperation",
          "reason": "The worktree-private operation id is an internal join key; the operation itself is reported by 'vlab reconcile --status'."
        }
      ]
    },
    {
      "name": "metadata-status",
      "argv": [
        "metadata",
        "status"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "The repository-wide metadata inventory, including quarantine counts and diagnostics.",
      "required": [
        {
          "pointer": "/repository/root",
          "rule": "exact"
        },
        {
          "pointer": "/repository/objectFormat",
          "rule": "exact"
        },
        {
          "pointer": "/repository/lineage/id",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/scopes/sharedPortable/notes/targetCount",
          "rule": "exact"
        },
        {
          "pointer": "/scopes/sharedPortable/notes/acceptedCount",
          "rule": "exact"
        },
        {
          "pointer": "/scopes/sharedPortable/notes/quarantinedCount",
          "rule": "exact"
        },
        {
          "pointer": "/summary/errors",
          "rule": "exact"
        },
        {
          "pointer": "/summary/warnings",
          "rule": "exact"
        },
        {
          "pointer": "/diagnostics/0/code",
          "rule": "exact"
        },
        {
          "pointer": "/diagnostics/0/subject",
          "rule": "exact"
        },
        {
          "pointer": "/trust/cryptographicallyTrusted",
          "rule": "mapped",
          "render": {
            "true": "; signed",
            "false": "; not signed"
          }
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/schema",
          "reason": "Machine dispatch key."
        },
        {
          "pointer": "/scopes/sharedPortable/notes/ref",
          "reason": "The notes ref is fixed for the tool; 'vlab doctor' reports it for automation."
        },
        {
          "pointer": "/repository/lineage/algorithm",
          "reason": "The lineage algorithm is versioned in the id's own contract; the reader needs the identity, not its derivation."
        },
        {
          "pointer": "/trust/statement",
          "reason": "The full trust disclaimer is summarized on the integrity line; the sentence itself is documentation, not state."
        },
        {
          "pointer": "/diagnostics/0/message",
          "reason": "The reader gets code and subject on one line; the long message is available in JSON for tooling that renders detail."
        }
      ]
    },
    {
      "name": "metadata-validate",
      "argv": [
        "metadata",
        "validate"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "Shares the status renderer; the distinct member is the validity verdict that sets the exit code.",
      "required": [
        {
          "pointer": "/repository/root",
          "rule": "exact"
        },
        {
          "pointer": "/repository/lineage/id",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/summary/valid",
          "rule": "mapped",
          "render": {
            "true": "integrity    valid",
            "false": "integrity    invalid"
          }
        },
        {
          "pointer": "/summary/errors",
          "rule": "exact"
        },
        {
          "pointer": "/summary/warnings",
          "rule": "exact"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/schema",
          "reason": "Machine dispatch key."
        },
        {
          "pointer": "/trust/statement",
          "reason": "As metadata status."
        }
      ]
    },
    {
      "name": "resolve-list",
      "argv": [
        "resolve",
        "list"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "The reusable resolution catalog.",
      "required": [
        {
          "pointer": "/0/id",
          "rule": "exact"
        },
        {
          "pointer": "/0/signature",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/0/resultBlob",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/0/originalPath",
          "rule": "exact"
        },
        {
          "pointer": "/0/createdAt",
          "rule": "exact"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/0/schema",
          "reason": "Machine dispatch key."
        },
        {
          "pointer": "/0/algorithm",
          "reason": "The signature algorithm is versioned inside the signature's own contract."
        },
        {
          "pointer": "/0/resolutionCommit",
          "reason": "The retention commit is an internal storage detail; the record is addressed by its id."
        },
        {
          "pointer": "/0/ref",
          "reason": "The retention ref is an internal storage detail."
        },
        {
          "pointer": "/0/attachedTo",
          "reason": "The attachment is implied by the resolution commit and is not part of choosing a resolution."
        }
      ]
    },
    {
      "name": "spec-merge-plan",
      "argv": [
        "spec",
        "merge-plan",
        "spec.md",
        "HEAD",
        "HEAD",
        "HEAD"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "The deterministic semantic specification merge.",
      "required": [
        {
          "pointer": "/status",
          "rule": "exact"
        },
        {
          "pointer": "/file",
          "rule": "exact"
        },
        {
          "pointer": "/artifactId",
          "rule": "exact"
        },
        {
          "pointer": "/signature",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/ordering/decision",
          "rule": "exact"
        },
        {
          "pointer": "/result/markdownHash",
          "rule": "prefix",
          "minPrefix": 12
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/schema",
          "reason": "Machine dispatch key."
        },
        {
          "pointer": "/algorithm",
          "reason": "The merge algorithm is versioned; the reader is told the outcome, not the rule set."
        },
        {
          "pointer": "/manifestFile",
          "reason": "The sidecar path is derived from the source path the reader is shown."
        },
        {
          "pointer": "/result/manifestHash",
          "reason": "The reader gets the Markdown hash; the manifest hash is the machine equality key for the sidecar."
        },
        {
          "pointer": "/base/sourceHash",
          "reason": "Per-stage fingerprints are machine comparison inputs behind the single ordering and status verdicts."
        }
      ]
    },
    {
      "name": "metadata-import-preview",
      "argv": [
        "metadata",
        "import",
        "{envelope}",
        "--dry-run"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "The import preview is the decision point before any ref moves.",
      "required": [
        {
          "pointer": "/path",
          "rule": "exact"
        },
        {
          "pointer": "/repository/lineageRelation",
          "rule": "exact"
        },
        {
          "pointer": "/summary/addRecords",
          "rule": "exact"
        },
        {
          "pointer": "/summary/noopRecords",
          "rule": "exact"
        },
        {
          "pointer": "/summary/conflicts",
          "rule": "exact"
        },
        {
          "pointer": "/summary/applicable",
          "rule": "mapped",
          "render": {
            "true": "applicable   yes",
            "false": "applicable   no"
          }
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/schema",
          "reason": "Machine dispatch key."
        },
        {
          "pointer": "/repository/sourceLineage",
          "reason": "The reader is told the lineage relation; the two lineage ids are the machine inputs to that verdict."
        },
        {
          "pointer": "/repository/destinationLineage",
          "reason": "As sourceLineage."
        },
        {
          "pointer": "/trust/statement",
          "reason": "As metadata status."
        }
      ]
    },
    {
      "name": "reconcile-status",
      "argv": [
        "reconcile",
        "--status"
      ],
      "stage": "paused",
      "mode": "reread",
      "note": "The resumable state of a paused reconciliation, and the conflict a caller must act on.",
      "required": [
        {
          "pointer": "/operationId",
          "rule": "exact"
        },
        {
          "pointer": "/state",
          "rule": "exact"
        },
        {
          "pointer": "/sourceRef",
          "rule": "exact"
        },
        {
          "pointer": "/sourceHead",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/targetBefore",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/progress/completed",
          "rule": "exact"
        },
        {
          "pointer": "/progress/total",
          "rule": "exact"
        },
        {
          "pointer": "/current/sourceCommit",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/current/sourceChangeId",
          "rule": "exact"
        },
        {
          "pointer": "/current/conflictedPaths/0",
          "rule": "exact"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/worktree",
          "reason": "The status is worktree-private by construction, so the path is the caller's own; automation that needs it has it in JSON."
        },
        {
          "pointer": "/startedAt",
          "reason": "Operation timestamps are audit data; the reader needs the resumable state, not when it began."
        },
        {
          "pointer": "/updatedAt",
          "reason": "As startedAt."
        },
        {
          "pointer": "/current/startedAt",
          "reason": "As startedAt."
        }
      ]
    },
    {
      "name": "resolve-status",
      "argv": [
        "resolve",
        "status"
      ],
      "stage": "paused",
      "mode": "reread",
      "note": "The conflicts of the pending operation and the recorded resolutions that could settle them.",
      "required": [
        {
          "pointer": "/operationId",
          "rule": "exact"
        },
        {
          "pointer": "/conflicts/0/path",
          "rule": "exact"
        },
        {
          "pointer": "/conflicts/0/signature",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/conflicts/0/candidates",
          "rule": "count"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/conflicts/0/algorithm",
          "reason": "The signature algorithm is versioned inside the signature's own contract."
        }
      ]
    },
    {
      "name": "audit-identity",
      "argv": [
        "audit",
        "identity"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "The repository-wide identity audit. A clean scenario reports no findings, so the required members are the scan scope and the counts a reader acts on.",
      "required": [
        {
          "pointer": "/repository/root",
          "rule": "exact"
        },
        {
          "pointer": "/scanned/commits",
          "rule": "exact"
        },
        {
          "pointer": "/scanned/changeIds",
          "rule": "exact"
        },
        {
          "pointer": "/scanned/applicationRecords",
          "rule": "exact"
        },
        {
          "pointer": "/summary/collisions",
          "rule": "exact"
        },
        {
          "pointer": "/summary/conflictingTrailers",
          "rule": "exact"
        },
        {
          "pointer": "/summary/ambiguousOrigins",
          "rule": "exact"
        },
        {
          "pointer": "/summary/errors",
          "rule": "exact"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/schema",
          "reason": "Machine dispatch key."
        },
        {
          "pointer": "/repository/objectFormat",
          "reason": "The object format is reported by vlab doctor and metadata status; the audit line names the repository, not its storage format."
        },
        {
          "pointer": "/scanned/causalRecords",
          "reason": "The total record count is scan context; the reader is shown the application records the audit actually reasons over."
        }
      ]
    },
    {
      "name": "provenance",
      "argv": [
        "provenance",
        "pick-source"
      ],
      "stage": "clean",
      "mode": "reread",
      "note": "Declared authorship provenance (FR-ID-08). The claim is unauthenticated and never inferred, so the rendering a person reads must say which it is rather than presenting it as detection (FR-TRUST-04).",
      "required": [
        {
          "pointer": "",
          "rule": "present",
          "label": "unverified claims, not detection"
        },
        {
          "pointer": "/entries/0/commit",
          "rule": "prefix",
          "minPrefix": 12
        },
        {
          "pointer": "/entries/0/id",
          "rule": "exact"
        },
        {
          "pointer": "/entries/0/origin",
          "rule": "exact"
        },
        {
          "pointer": "/entries/0/actors/0/role",
          "rule": "exact"
        },
        {
          "pointer": "/entries/0/actors/0/actor",
          "rule": "exact"
        },
        {
          "pointer": "/entries/0/actors/1/role",
          "rule": "exact"
        },
        {
          "pointer": "/entries/0/actors/1/actor",
          "rule": "exact"
        }
      ],
      "jsonOnly": [
        {
          "pointer": "/revision",
          "reason": "The revision the caller asked about; a person already knows what they typed."
        },
        {
          "pointer": "/inspected",
          "reason": "How many commits were read, a scope measure rather than part of the claim."
        },
        {
          "pointer": "/entries/0/changeId",
          "reason": "The logical change is reported by the planning and receipt commands; the provenance rendering identifies the commit."
        },
        {
          "pointer": "/entries/0/createdAt",
          "reason": "When the claim was recorded is audit detail, not part of who produced the content."
        },
        {
          "pointer": "/entries/0/carriedFrom",
          "reason": "Empty for a declared record; the rendering names sources only when there are some."
        }
      ]
    }
  ],
  "jsonOnlyCommands": [
    {
      "argv": [
        "workspace",
        "list"
      ],
      "reason": "Passes a hardcoded true to print; the workspace registry has no human rendering."
    },
    {
      "argv": [
        "workspace",
        "prune",
        "--dry-run"
      ],
      "reason": "Prints the prune record; no human rendering exists."
    },
    {
      "argv": [
        "spec",
        "show",
        "spec.md"
      ],
      "reason": "Passes a hardcoded true to print; the materialized manifest has no human rendering."
    },
    {
      "argv": [
        "doctor"
      ],
      "reason": "A diagnostic report for tooling; it is JSON by design and is where the build identity lives."
    },
    {
      "argv": [
        "proof-bundle",
        "plan-source"
      ],
      "reason": "The bundle exists to be handed to another tool; a human rendering of it would be the very prose a verifier must not trust (FR-PLAN-08)."
    }
  ],
  "textOnlyCommands": [
    {
      "argv": [
        "version"
      ],
      "reason": "An acknowledgement line. The build identity has its machine form in 'vlab doctor'."
    },
    {
      "argv": [
        "graph"
      ],
      "reason": "An ASCII presentation of Git history plus a folded view of causal edges. The history is git log --graph; every edge comes from records 'vlab receipts --json' returns in full."
    },
    {
      "argv": [
        "help"
      ],
      "reason": "The command inventory. Automation cannot enumerate commands from JSON; a known limitation, not a state gap."
    }
  ],
  "failureCommands": [
    {
      "name": "unresolved-revision",
      "argv": [
        "merge-plan",
        "no-such-ref",
        "--json"
      ],
      "stage": "clean",
      "code": "revision-not-resolved",
      "reason": "A reference that is not there is the most ordinary failure there is, and it must not be classified as a Git defect."
    },
    {
      "name": "missing-argument",
      "argv": [
        "cherry-pick",
        "--json"
      ],
      "stage": "clean",
      "code": "usage-missing-argument",
      "reason": "The caller left out a required argument; the response is to supply it."
    },
    {
      "name": "unknown-command",
      "argv": [
        "no-such-command",
        "--json"
      ],
      "stage": "clean",
      "code": "usage-unknown-command",
      "reason": "Dispatch reaches the per-command options before it rejects the name, so even this failure honours --json."
    },
    {
      "name": "operation-already-pending",
      "argv": [
        "reconcile",
        "second",
        "--json"
      ],
      "stage": "paused",
      "code": "operation-in-progress",
      "reason": "Starting a second operation while one is paused is refused, and a caller must be able to tell that apart from the conflict that paused it."
    }
  ]
}
