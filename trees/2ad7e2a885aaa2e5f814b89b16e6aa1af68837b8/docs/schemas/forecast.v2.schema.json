{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.forecast/v2",
  "title": "Reconciliation forecast",
  "description": "Pinned reconciliation simulation and approvals, stored worktree-private under .git/vcs-lab/forecasts/ and returned by vlab forecast --json and vlab workspace forecast --json (src/forecasts.js). Supersedes vcs-lab.forecast/v1, which is still accepted on read.",
  "x-vcs-lab-scope": "worktree-private",
  "type": "object",
  "required": [
    "schema", "id", "sourceRef", "sourceHead", "targetHead", "targetWorktree",
    "scope", "ignoredTargetDirtyFiles", "acceptCandidates",
    "candidateDecisionRequired", "planFingerprint", "plan", "status",
    "blockedReason", "steps", "approvedResolutions", "approvedSpecMerges",
    "counts", "simulatedChanges", "remainingChanges", "partialResultTree",
    "predictedResultTree", "exactStateEqualityAfter", "engine", "fallbacks",
    "workspaceComparison", "timings", "startedAt", "createdAt"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.forecast/v2" },
    "id": { "type": "string", "pattern": "^forecast_[a-z0-9]+$" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceHead": { "$ref": "#/$defs/oid" },
    "targetHead": { "$ref": "#/$defs/oid" },
    "targetWorktree": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "string",
      "description": "'committed-heads' or 'source-checkpoint'."
    },
    "ignoredTargetDirtyFiles": { "type": "integer", "minimum": 0 },
    "acceptCandidates": { "type": "boolean" },
    "candidateDecisionRequired": { "type": "boolean" },
    "planFingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "plan": { "$ref": "vcs-lab.merge-plan/v1" },
    "status": {
      "type": "string",
      "description": "'complete', 'blocked', or 'review-required'."
    },
    "blockedReason": { "type": ["string", "null"] },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/simulationStep" } },
    "approvedResolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/approvedResolution" }
    },
    "approvedSpecMerges": {
      "type": "array",
      "items": { "$ref": "#/$defs/approvedSpecMerge" }
    },
    "counts": { "$ref": "#/$defs/simulationCounts" },
    "simulatedChanges": { "type": "integer", "minimum": 0 },
    "remainingChanges": { "type": "integer", "minimum": 0 },
    "partialResultTree": { "$ref": "#/$defs/oidOrNull" },
    "predictedResultTree": { "$ref": "#/$defs/oidOrNull" },
    "exactStateEqualityAfter": { "type": ["boolean", "null"] },
    "engine": {
      "type": "string",
      "description": "The forecast engine that produced the simulation: 'worktree' or 'merge-tree'."
    },
    "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/engineFallback" } },
    "workspaceComparison": {
      "type": ["object", "null"],
      "description": "Workspace/checkpoint comparison context for vlab workspace forecast; null for plain reconciliation forecasts."
    },
    "timings": {
      "type": "object",
      "required": ["forecastMs", "phases", "worktree", "mergeTree", "git"],
      "properties": {
        "forecastMs": { "type": "number" },
        "phases": { "type": "object" },
        "worktree": { "$ref": "#/$defs/phaseTimings" },
        "mergeTree": { "$ref": "#/$defs/phaseTimings" },
        "git": { "$ref": "#/$defs/gitMetrics" }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" },
    "oidOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    },
    "simulationStep": {
      "type": "object",
      "required": ["sourceCommit", "changeId", "subject", "outcome", "targetBeforeTree"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "changeId": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "outcome": {
          "type": "string",
          "description": "'clean', 'exact-resolution', 'semantic-spec-merge', 'semantic-spec-and-exact-resolution', or a 'blocked-*' value."
        },
        "relation": { "type": "string" },
        "targetBeforeTree": { "$ref": "#/$defs/oid" },
        "resultTree": { "$ref": "#/$defs/oid" },
        "conflicts": { "type": "array" },
        "resolutions": { "type": "array" },
        "semanticMerges": { "type": "array" },
        "gitOutput": { "type": "string" }
      }
    },
    "approvedResolution": {
      "type": "object",
      "required": ["sourceCommit", "path", "signature", "resolutionId", "resultBlob"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "path": { "type": "string" },
        "signature": { "type": "string", "pattern": "^rsig_[0-9a-fA-F]{64}$" },
        "resolutionId": { "type": "string" },
        "resultBlob": { "$ref": "#/$defs/oidOrNull" }
      }
    },
    "approvedSpecMerge": {
      "type": "object",
      "required": ["sourceCommit", "path", "signature", "resultMarkdownHash", "resultManifestHash"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "path": { "type": "string" },
        "signature": { "type": "string" },
        "resultMarkdownHash": { "type": ["string", "null"] },
        "resultManifestHash": { "type": ["string", "null"] }
      }
    },
    "simulationCounts": {
      "type": "object",
      "required": [
        "clean", "exactResolution", "exactResolutionPaths", "semanticSpec",
        "semanticSpecPaths", "blocked"
      ],
      "properties": {
        "clean": { "type": "integer", "minimum": 0 },
        "exactResolution": { "type": "integer", "minimum": 0 },
        "exactResolutionPaths": { "type": "integer", "minimum": 0 },
        "semanticSpec": { "type": "integer", "minimum": 0 },
        "semanticSpecPaths": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "engineFallback": {
      "type": "object",
      "required": ["engine", "reason"],
      "properties": {
        "engine": { "type": "string" },
        "reason": { "type": "string" },
        "step": { "type": "integer", "minimum": 0 },
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "requiredGit": { "type": "string" },
        "git": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "phaseTimings": {
      "type": "object",
      "required": ["setupMs", "applicationMs", "cleanupMs", "totalMs"],
      "properties": {
        "setupMs": { "type": "number" },
        "applicationMs": { "type": "number" },
        "cleanupMs": { "type": "number" },
        "totalMs": { "type": "number" }
      }
    },
    "gitMetrics": {
      "type": "object",
      "required": ["count", "processes", "sessionQueries", "cacheHits", "totalMs", "failed", "byCommand"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "processes": { "type": "integer", "minimum": 0 },
        "sessionQueries": { "type": "integer", "minimum": 0 },
        "cacheHits": { "type": "integer", "minimum": 0 },
        "totalMs": { "type": "number" },
        "failed": { "type": "integer", "minimum": 0 },
        "engine": { "type": "string" },
        "fallbacks": { "type": "array" },
        "directReads": { "type": "integer", "minimum": 0 },
        "byCommand": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "count", "processes", "sessionQueries", "cacheHits", "totalMs", "maxMs"],
            "properties": {
              "command": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "processes": { "type": "integer", "minimum": 0 },
              "sessionQueries": { "type": "integer", "minimum": 0 },
              "cacheHits": { "type": "integer", "minimum": 0 },
              "totalMs": { "type": "number" },
              "maxMs": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
