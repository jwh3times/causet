{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.metadata-disposition/v1",
  "title": "Conflict disposition result",
  "description": "CLI output of vlab metadata dispose --json: the recorded decision and what it did to the disputed record (src/dispositions.js).",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema",
    "disposition",
    "parkedRef",
    "parkedRemoved",
    "record"
  ],
  "properties": {
    "schema": {
      "const": "vcs-lab.metadata-disposition/v1"
    },
    "disposition": {
      "$ref": "vcs-lab.disposition/v1"
    },
    "parkedRef": {
      "type": "string",
      "minLength": 1
    },
    "parkedRemoved": {
      "type": "boolean"
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "attachment",
        "inService"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "attachment": {
          "$ref": "#/$defs/oid"
        },
        "inService": {
          "type": "boolean",
          "description": "Whether the record is accepted by the metadata snapshot taken after the disposition. Clearing the dispute is necessary and not sufficient: a record can still be quarantined for an unrelated reason, which `diagnostics` names."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Diagnostic codes still against the record, empty when it is in service."
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    }
  }
}
