{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.landing/v1",
  "title": "Landing receipt",
  "description": "Compact or hard-squash causal landing receipt, attached to the landing commit (shared-portable note record; src/landings.js).",
  "x-vcs-lab-scope": "note-record",
  "type": "object",
  "required": [
    "schema", "type", "id", "mode", "sourceRef", "sourceHead", "sourceSubject",
    "targetBefore", "landingCommit", "base", "absorbedCommits",
    "absorbedChanges", "resultTree", "createdAt"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.landing/v1" },
    "type": { "const": "landing" },
    "id": { "type": "string", "minLength": 4 },
    "mode": { "enum": ["compact", "hard-squash"] },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceHead": { "$ref": "#/$defs/oid" },
    "sourceSubject": { "type": "string" },
    "targetBefore": { "$ref": "#/$defs/oid" },
    "landingCommit": {
      "$ref": "#/$defs/oid",
      "description": "The commit this record is attached to; when the record carries attachedTo, both must be equal."
    },
    "base": { "$ref": "#/$defs/oid" },
    "absorbedCommits": { "type": "array", "items": { "$ref": "#/$defs/oid" } },
    "absorbedChanges": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resultTree": { "$ref": "#/$defs/oid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "attachedTo": {
      "$ref": "#/$defs/oid",
      "description": "Added by catalog listings: the commit the note is attached to. Not stored in the note itself."
    }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" }
  }
}
