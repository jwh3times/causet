{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.rebase/v1",
  "title": "Causal rebase receipt",
  "description": "Completed causal rebase summary with plan identity, omissions, applications, trees, and timing, attached to the rebased tip (shared-portable note record; src/rebase-operations.js finalizeRebase).",
  "x-vcs-lab-scope": "note-record",
  "type": "object",
  "required": [
    "schema",
    "type",
    "id",
    "operationId",
    "forecastId",
    "sourceRef",
    "sourceHead",
    "ontoRef",
    "ontoHead",
    "physicalBase",
    "effectiveBase",
    "planFingerprint",
    "acceptCandidates",
    "candidatePolicy",
    "omitted",
    "acceptedCandidates",
    "applications",
    "forkedSourceCommits",
    "absorbedCommits",
    "absorbedChanges",
    "resultCommit",
    "sourceTree",
    "ontoTree",
    "resultTree",
    "exactStateEqualityAfter",
    "timings",
    "startedAt",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "vcs-lab.rebase/v1"
    },
    "type": {
      "const": "rebase"
    },
    "id": {
      "type": "string",
      "minLength": 4
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "forecastId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceHead": {
      "$ref": "#/$defs/oid"
    },
    "ontoRef": {
      "type": "string",
      "minLength": 1
    },
    "ontoHead": {
      "$ref": "#/$defs/oid"
    },
    "physicalBase": {
      "$ref": "#/$defs/oid"
    },
    "effectiveBase": {
      "type": "object",
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/oid"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "acceptCandidates": {
      "type": "boolean"
    },
    "candidatePolicy": {
      "enum": [
        "none",
        "accepted",
        "review-required"
      ]
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "proof"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "changeId": {
            "type": "string"
          },
          "proof": {
            "type": [
              "string",
              "null"
            ],
            "description": "Coverage proof, or null for new work: commit-ancestry, receipt-commit, stable-change-id, receipt-change-id, git-patch-id-heuristic. Records written before v0.12.0 may carry signed-shaped-landing-receipt where receipt-commit now appears; nothing branches on the value, so readers pass it through unchanged (docs/schemas/compatibility.md)."
          }
        }
      }
    },
    "acceptedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "proof",
          "decision"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "changeId": {
            "type": "string"
          },
          "proof": {
            "type": [
              "string",
              "null"
            ],
            "description": "Coverage proof, or null for new work: commit-ancestry, receipt-commit, stable-change-id, receipt-change-id, git-patch-id-heuristic. Records written before v0.12.0 may carry signed-shaped-landing-receipt where receipt-commit now appears; nothing branches on the value, so readers pass it through unchanged (docs/schemas/compatibility.md)."
          },
          "subject": {
            "type": "string"
          },
          "decision": {
            "const": "omit"
          }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceCommit",
          "sourceChangeId",
          "appliedCommit",
          "appliedChangeId",
          "targetBeforeTree",
          "resultTree",
          "relation",
          "conflictedPaths",
          "resolutions",
          "semanticMerges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceCommit": {
            "$ref": "#/$defs/oid"
          },
          "sourceChangeId": {
            "type": "string",
            "minLength": 1
          },
          "appliedCommit": {
            "$ref": "#/$defs/oid"
          },
          "appliedChangeId": {
            "type": "string",
            "minLength": 1
          },
          "targetBeforeTree": {
            "$ref": "#/$defs/oid"
          },
          "resultTree": {
            "$ref": "#/$defs/oid"
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "conflictedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolutions": {
            "type": "array"
          },
          "semanticMerges": {
            "type": "array"
          }
        }
      }
    },
    "forkedSourceCommits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oid"
      }
    },
    "absorbedCommits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oid"
      }
    },
    "absorbedChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resultCommit": {
      "$ref": "#/$defs/oid",
      "description": "The commit this record is attached to; when the record carries attachedTo, both must be equal."
    },
    "sourceTree": {
      "$ref": "#/$defs/oid"
    },
    "ontoTree": {
      "$ref": "#/$defs/oid"
    },
    "resultTree": {
      "$ref": "#/$defs/oid"
    },
    "exactStateEqualityAfter": {
      "type": "boolean"
    },
    "timings": {
      "type": "object",
      "description": "Pre-publication operation measurements, not whole-command telemetry. See docs/schemas/receipt-timings.md for the distinct measurement boundaries.",
      "required": [
        "activeApplicationMs",
        "elapsedWallMs",
        "git"
      ],
      "properties": {
        "activeApplicationMs": {
          "type": "number",
          "description": "Accumulated active application spans, including successful continuation setup, excluding user pause time and finalization/publication."
        },
        "elapsedWallMs": {
          "type": "number",
          "description": "Wall time from operation.startedAt to receipt construction before publication, including time paused between invocations; not end-to-end command latency."
        },
        "git": {
          "description": "Accumulated Git metric scopes inside application-queue calls. Excludes planning, continuation work before queue entry, finalization, record/provenance publication, and journal cleanup. Null means unavailable, not zero cost.",
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "attachedTo": {
      "$ref": "#/$defs/oid"
    },
    "quarantinedFacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Identifiers reachable from the target that the conflict rule excluded, so a reviewer can see that coverage was computed on reduced evidence (ADR-0030). Absent in records written before v0.15.0; an empty array means nothing was excluded. Deliberately outside every plan fingerprint."
    },
    "range": {
      "type": "object",
      "required": [
        "base",
        "tip",
        "explicit"
      ],
      "description": "The source set this plan describes. Without --from, `base` is the physical merge base and `explicit` is false, so a v1 plan is unchanged. The plan fingerprint covers `base`, because it decides what would be replayed; it does not cover `explicit`, because naming the same base is the same range (ADR-0032). Absent in records written before v0.15.0.",
      "properties": {
        "baseRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "The revision the caller named, as typed, or null when the base was implicit."
        },
        "base": {
          "$ref": "#/$defs/oid"
        },
        "tip": {
          "$ref": "#/$defs/oid"
        },
        "explicit": {
          "type": "boolean"
        }
      }
    },
    "excludedByRange": {
      "type": "array",
      "description": "Commits between the physical merge base and the range base: work the caller declared out of the source set. They are listed and nothing else — never replayed, classified, absorbed, or covered, and no receipt claims them. The omission is declared, not proven (ADR-0032).",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "subject"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    }
  }
}
