{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.spec-benchmark/v2",
  "title": "Spec index benchmark",
  "description": "Generated-corpus measurements of vlab spec benchmark --json (CLI output; src/specs.js benchmarkSpecIndex).",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema", "manifestSchema", "documents", "blocksPerDocument",
    "semanticEntities", "sourceBytes", "manifestBytes",
    "manifestToSourceRatio", "estimatedCompressedSourceBytes",
    "estimatedCompressedManifestBytes",
    "estimatedCompressedManifestToSourceRatio", "legacyV2EquivalentBytes",
    "metadataReductionPercent", "estimatedCompressedLegacyV2Bytes",
    "estimatedCompressedMetadataReductionPercent", "bytesPerEntity", "cold",
    "unchanged", "oneBlockChanged"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.spec-benchmark/v2" },
    "manifestSchema": { "const": "vcs-lab.spec-manifest/v3" },
    "documents": { "type": "integer", "minimum": 1 },
    "blocksPerDocument": { "type": "integer", "minimum": 1 },
    "semanticEntities": { "type": "integer", "minimum": 0 },
    "sourceBytes": { "type": "integer", "minimum": 0 },
    "manifestBytes": { "type": "integer", "minimum": 0 },
    "manifestToSourceRatio": { "type": "number" },
    "estimatedCompressedSourceBytes": { "type": "integer", "minimum": 0 },
    "estimatedCompressedManifestBytes": { "type": "integer", "minimum": 0 },
    "estimatedCompressedManifestToSourceRatio": { "type": "number" },
    "legacyV2EquivalentBytes": { "type": "integer", "minimum": 0 },
    "metadataReductionPercent": { "type": "number" },
    "estimatedCompressedLegacyV2Bytes": { "type": "integer", "minimum": 0 },
    "estimatedCompressedMetadataReductionPercent": { "type": "number" },
    "bytesPerEntity": { "type": "number" },
    "cold": {
      "type": "object",
      "description": "Cold full-index run summary (files, cache hits, blocks, change counts, duration)."
    },
    "unchanged": {
      "type": "object",
      "description": "Unchanged re-index run summary."
    },
    "oneBlockChanged": {
      "type": "object",
      "description": "Re-index run summary after one block changed in one document."
    }
  }
}
