{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.rebase-plan/v1",
  "title": "Causal rebase plan",
  "description": "Read-only causal rebase selection and constraints (CLI output of vlab rebase-plan --json; embedded as the plan of rebase forecasts and journals; src/rebase-plan.js).",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "ontoRef",
    "ontoHead",
    "sourceRef",
    "sourceHead",
    "ontoTree",
    "sourceTree",
    "exactStateEquality",
    "physicalBase",
    "effectiveBase",
    "reachableReceipts",
    "constraints",
    "counts",
    "changes",
    "replayQueue",
    "omitted",
    "candidates",
    "candidateDecisionRequired",
    "executableWithoutReview",
    "fingerprint"
  ],
  "properties": {
    "schema": {
      "const": "vcs-lab.rebase-plan/v1"
    },
    "mode": {
      "const": "linear"
    },
    "ontoRef": {
      "type": "string",
      "minLength": 1
    },
    "ontoHead": {
      "$ref": "#/$defs/oid"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceHead": {
      "$ref": "#/$defs/oid"
    },
    "ontoTree": {
      "$ref": "#/$defs/oid"
    },
    "sourceTree": {
      "$ref": "#/$defs/oid"
    },
    "exactStateEquality": {
      "type": "boolean"
    },
    "physicalBase": {
      "$ref": "#/$defs/oid"
    },
    "effectiveBase": {
      "type": "object",
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/oid"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "reachableReceipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "supported",
        "linearHistory",
        "mergeCommits"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "linearHistory": {
          "type": "boolean"
        },
        "mergeCommits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oid"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "covered",
        "candidate-equivalent",
        "new"
      ],
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "candidate-equivalent": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "shortCommit",
          "changeId",
          "subject",
          "status",
          "proof",
          "action",
          "changedPaths"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "shortCommit": {
            "type": "string",
            "minLength": 1
          },
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "enum": [
              "covered",
              "candidate-equivalent",
              "new"
            ]
          },
          "changedPaths": {
            "type": "array",
            "description": "Paths this commit touched, read from the same git log process that builds the queue. The merge-tree forecast engine uses them to detect a nested .gitattributes edit it would otherwise simulate under the wrong attributes (ADR-0016).",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "enum": [
              "omit",
              "review",
              "replay"
            ]
          }
        }
      }
    },
    "replayQueue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "shortCommit",
          "changeId",
          "subject"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "shortCommit": {
            "type": "string",
            "minLength": 1
          },
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string"
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "proof"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "proof",
          "subject"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "type": "string"
          }
        }
      }
    },
    "candidateDecisionRequired": {
      "type": "boolean"
    },
    "executableWithoutReview": {
      "type": "boolean"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "quarantinedFacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Identifiers reachable from the target that the conflict rule excluded, so a reviewer can see that coverage was computed on reduced evidence (ADR-0030). Absent in records written before v0.15.0; an empty array means nothing was excluded. Deliberately outside every plan fingerprint."
    },
    "range": {
      "type": "object",
      "required": [
        "base",
        "tip",
        "explicit"
      ],
      "description": "The source set this plan describes. Without --from, `base` is the physical merge base and `explicit` is false, so a v1 plan is unchanged. The plan fingerprint covers `base`, because it decides what would be replayed; it does not cover `explicit`, because naming the same base is the same range (ADR-0032). Absent in records written before v0.15.0.",
      "properties": {
        "baseRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "The revision the caller named, as typed, or null when the base was implicit."
        },
        "base": {
          "$ref": "#/$defs/oid"
        },
        "tip": {
          "$ref": "#/$defs/oid"
        },
        "explicit": {
          "type": "boolean"
        }
      }
    },
    "excludedByRange": {
      "type": "array",
      "description": "Commits between the physical merge base and the range base: work the caller declared out of the source set. They are listed and nothing else — never replayed, classified, absorbed, or covered, and no receipt claims them. The omission is declared, not proven (ADR-0032).",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "subject"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/oid"
          },
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    }
  }
}
