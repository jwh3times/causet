{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.metadata-import-preview/v1",
  "title": "Metadata import preview",
  "description": "Exact dry-run record/ref/object actions of vlab metadata import --dry-run --json (CLI output; src/metadata-transfer.js). vcs-lab.metadata-import/v1 extends this shape.",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema",
    "path",
    "repository",
    "records",
    "refs",
    "objectProblems",
    "summary",
    "exclusions",
    "trust"
  ],
  "properties": {
    "schema": {
      "const": "vcs-lab.metadata-import-preview/v1"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recordAction"
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/refAction"
      }
    },
    "objectProblems": {
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust": {
      "type": "object",
      "required": [
        "cryptographicallySigned",
        "authorized",
        "statement"
      ],
      "properties": {
        "cryptographicallySigned": {
          "const": false
        },
        "authorized": {
          "const": false
        },
        "statement": {
          "type": "string"
        }
      }
    },
    "mode": {
      "enum": [
        "refuse-conflicts",
        "park-conflicts"
      ],
      "description": "refuse-conflicts is the default of an explicit import: one conflict makes the whole envelope inapplicable and no ref moves. park-conflicts applies the rest and parks each conflicting record; it is the only mode an automatic transport may use (ADR-0030)."
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    },
    "repository": {
      "type": "object",
      "required": [
        "objectFormat",
        "lineageRelation",
        "sourceLineage",
        "destinationLineage"
      ],
      "properties": {
        "objectFormat": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "lineageRelation": {
          "type": "string",
          "description": "'same', 'fork', 'unrelated', or 'incompatible'."
        },
        "sourceLineage": {
          "type": "string",
          "pattern": "^lineage_[0-9a-f]{64}$"
        },
        "destinationLineage": {
          "type": "string",
          "pattern": "^lineage_[0-9a-f]{64}$"
        }
      }
    },
    "recordAction": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "'add', 'noop', 'conflict', 'park', or 'disposed'. 'park' and 'disposed' appear only under --park-conflicts and for a digest a disposition already rejected; neither is an unresolved conflict, so neither makes the envelope inapplicable (ADR-0030)."
        },
        "localDigests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of the local records already carrying this identifier, which is what a conflict is measured against."
        }
      }
    },
    "refAction": {
      "type": "object",
      "required": [
        "ref",
        "incoming",
        "existing",
        "action"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "incoming": {
          "$ref": "#/$defs/oid"
        },
        "existing": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        },
        "action": {
          "type": "string",
          "description": "'create', 'merge', 'noop', 'conflict', or 'refuse'. 'refuse' appears only under --park-conflicts: a resolution ref the destination already points elsewhere is left alone and the incoming records naming it are parked, so one disputed ref does not refuse the whole exchange (ADR-0030)."
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "addRecords",
        "noopRecords",
        "createRefs",
        "mergeRefs",
        "noopRefs",
        "conflicts",
        "applicable"
      ],
      "properties": {
        "addRecords": {
          "type": "integer",
          "minimum": 0
        },
        "noopRecords": {
          "type": "integer",
          "minimum": 0
        },
        "createRefs": {
          "type": "integer",
          "minimum": 0
        },
        "mergeRefs": {
          "type": "integer",
          "minimum": 0
        },
        "noopRefs": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "applicable": {
          "type": "boolean"
        },
        "parkRecords": {
          "type": "integer",
          "minimum": 0,
          "description": "Conflicting records parked under refs/vcs-lab/quarantine by this import."
        },
        "disposedRecords": {
          "type": "integer",
          "minimum": 0,
          "description": "Incoming records whose digest a local disposition has already rejected; reported rather than parked again."
        },
        "refusedRefs": {
          "type": "integer",
          "minimum": 0,
          "description": "Refs left unchanged because the destination points them elsewhere; their records are parked."
        }
      }
    }
  }
}
