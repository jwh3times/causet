{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.spec-manifest/v2",
  "title": "Sparse specification manifest (superseded)",
  "description": "Superseded tracked-portable spec manifest that stored the full block inventory inline. Accepted on read and migrated to vcs-lab.spec-manifest/v3 on the next index (src/specs.js materializeManifest). The reader requires only schema, artifactId, source, and sourceHash.",
  "x-vcs-lab-scope": "tracked",
  "deprecated": true,
  "type": "object",
  "required": ["schema", "artifactId", "source", "sourceHash"],
  "properties": {
    "schema": { "const": "vcs-lab.spec-manifest/v2" },
    "artifactId": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "sourceBytes": { "type": "integer", "minimum": 0 },
    "sourceLines": { "type": "integer", "minimum": 0 },
    "representation": { "type": "string" },
    "parser": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "kind", "semanticKey", "startLine", "endLine", "contentHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["preamble", "section", "requirement"] },
        "semanticKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "level": { "type": ["integer", "null"] },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
