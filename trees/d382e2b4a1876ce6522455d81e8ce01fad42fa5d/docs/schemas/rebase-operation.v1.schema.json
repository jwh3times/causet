{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.rebase-operation/v1",
  "title": "Causal rebase operation journal",
  "description": "Private supervised-replay and recovery journal, stored worktree-private at .git/vcs-lab/rebase.json while a causal rebase is in progress (src/rebase-operations.js startOperation).",
  "x-vcs-lab-scope": "worktree-private",
  "type": "object",
  "required": [
    "schema", "id", "state", "worktree", "sourceRef", "sourceBranchRef",
    "sourceHead", "originalHead", "ontoRef", "ontoHead", "acceptCandidates",
    "candidatePolicy", "forecastId", "forecastApproval", "plan", "queue",
    "nextIndex", "applied", "current", "startedAt", "timings", "updatedAt"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.rebase-operation/v1" },
    "id": { "type": "string", "pattern": "^rebase_op_[a-z0-9]+$" },
    "state": {
      "type": "string",
      "description": "'prepared', 'resetting', 'running', 'applying', 'conflicted', 'blocked', 'forecast-mismatch', or 'identity-mismatch'."
    },
    "worktree": { "type": "string", "minLength": 1 },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceBranchRef": { "type": "string", "pattern": "^refs/heads/" },
    "sourceHead": { "$ref": "#/$defs/oid" },
    "originalHead": { "$ref": "#/$defs/oid" },
    "ontoRef": { "type": "string", "minLength": 1 },
    "ontoHead": { "$ref": "#/$defs/oid" },
    "acceptCandidates": { "type": "boolean" },
    "candidatePolicy": { "enum": ["none", "accepted", "review-required"] },
    "forecastId": { "type": ["string", "null"] },
    "forecastApproval": {
      "type": ["object", "null"],
      "required": [
        "id", "planFingerprint", "steps", "approvedResolutions",
        "approvedSpecMerges", "acceptedCandidates", "predictedResultTree"
      ],
      "properties": {
        "id": { "type": "string" },
        "planFingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "steps": { "type": "array" },
        "approvedResolutions": { "type": "array" },
        "approvedSpecMerges": { "type": "array" },
        "acceptedCandidates": { "type": "array" },
        "predictedResultTree": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        }
      }
    },
    "plan": { "$ref": "vcs-lab.rebase-plan/v1" },
    "queue": {
      "type": "array",
      "description": "The plan changes with action 'replay', in replay order.",
      "items": { "type": "object", "required": ["commit", "changeId", "action"] }
    },
    "nextIndex": { "type": "integer", "minimum": 0 },
    "applied": {
      "type": "array",
      "items": { "$ref": "vcs-lab.rebase-application/v1" }
    },
    "current": {
      "type": ["object", "null"],
      "required": ["sourceCommit", "sourceChangeId", "targetBefore"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "sourceChangeId": { "type": "string", "minLength": 1 },
        "targetBefore": { "$ref": "#/$defs/oid" },
        "targetBeforeTree": { "$ref": "#/$defs/oid" },
        "conflictedPaths": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array" },
        "gitOutput": { "type": "string" },
        "resolutionOutcomes": { "type": "array" },
        "semanticMerges": { "type": "array" },
        "forkChangeId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "timings": {
      "type": "object",
      "required": ["activeApplicationMs", "git"],
      "properties": {
        "activeApplicationMs": { "type": "number" },
        "git": { "type": ["object", "null"] }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" }
  }
}
