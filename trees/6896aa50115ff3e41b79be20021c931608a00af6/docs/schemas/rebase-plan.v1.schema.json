{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.rebase-plan/v1",
  "title": "Causal rebase plan",
  "description": "Read-only causal rebase selection and constraints (CLI output of vlab rebase-plan --json; embedded as the plan of rebase forecasts and journals; src/rebase-plan.js).",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema", "mode", "ontoRef", "ontoHead", "sourceRef", "sourceHead",
    "ontoTree", "sourceTree", "exactStateEquality", "physicalBase",
    "effectiveBase", "reachableReceipts", "constraints", "counts", "changes",
    "replayQueue", "omitted", "candidates", "candidateDecisionRequired",
    "executableWithoutReview", "fingerprint"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.rebase-plan/v1" },
    "mode": { "const": "linear" },
    "ontoRef": { "type": "string", "minLength": 1 },
    "ontoHead": { "$ref": "#/$defs/oid" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceHead": { "$ref": "#/$defs/oid" },
    "ontoTree": { "$ref": "#/$defs/oid" },
    "sourceTree": { "$ref": "#/$defs/oid" },
    "exactStateEquality": { "type": "boolean" },
    "physicalBase": { "$ref": "#/$defs/oid" },
    "effectiveBase": {
      "type": "object",
      "required": ["commit"],
      "properties": {
        "commit": { "$ref": "#/$defs/oid" },
        "reason": { "type": "string" }
      }
    },
    "reachableReceipts": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "object",
      "required": ["supported", "linearHistory", "mergeCommits"],
      "properties": {
        "supported": { "type": "boolean" },
        "linearHistory": { "type": "boolean" },
        "mergeCommits": { "type": "array", "items": { "$ref": "#/$defs/oid" } }
      }
    },
    "counts": {
      "type": "object",
      "required": ["covered", "candidate-equivalent", "new"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "candidate-equivalent": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commit", "shortCommit", "changeId", "subject", "status", "proof", "action", "changedPaths"],
        "properties": {
          "commit": { "$ref": "#/$defs/oid" },
          "shortCommit": { "type": "string", "minLength": 1 },
          "changeId": { "type": "string", "minLength": 1 },
          "subject": { "type": "string" },
          "status": { "enum": ["covered", "candidate-equivalent", "new"] },
          "changedPaths": {
            "type": "array",
            "description": "Paths this commit touched, read from the same git log process that builds the queue. The merge-tree forecast engine uses them to detect a nested .gitattributes edit it would otherwise simulate under the wrong attributes (ADR-0016).",
            "items": { "type": "string", "minLength": 1 }
          },
          "proof": { "type": ["string", "null"] },
          "action": { "enum": ["omit", "review", "replay"] }
        }
      }
    },
    "replayQueue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commit", "shortCommit", "changeId", "subject"],
        "properties": {
          "commit": { "$ref": "#/$defs/oid" },
          "shortCommit": { "type": "string", "minLength": 1 },
          "changeId": { "type": "string", "minLength": 1 },
          "subject": { "type": "string" }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commit", "changeId", "proof"],
        "properties": {
          "commit": { "$ref": "#/$defs/oid" },
          "changeId": { "type": "string", "minLength": 1 },
          "proof": { "type": ["string", "null"] }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commit", "changeId", "proof", "subject"],
        "properties": {
          "commit": { "$ref": "#/$defs/oid" },
          "changeId": { "type": "string", "minLength": 1 },
          "proof": { "type": ["string", "null"] },
          "subject": { "type": "string" }
        }
      }
    },
    "candidateDecisionRequired": { "type": "boolean" },
    "executableWithoutReview": { "type": "boolean" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" }
  }
}
