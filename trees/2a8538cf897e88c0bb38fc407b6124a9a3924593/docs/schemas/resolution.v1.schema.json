{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.resolution/v1",
  "title": "Exact resolution record",
  "description": "Exact conflict-resolution result and provenance, attached to its retention commit under refs/vcs-lab/resolutions/ (shared-portable note record; src/resolutions.js publishResolution). Catalog listings additionally add attachedTo, discoveredRef, and commit projections.",
  "x-vcs-lab-scope": "note-record",
  "type": "object",
  "required": [
    "schema", "type", "id", "signature", "algorithm", "base", "ours",
    "theirs", "resultBlob", "resultMode", "originalPath",
    "originatingApplication", "originatingCommit", "originatingChangeId",
    "decision", "ref", "resolutionCommit", "createdAt"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.resolution/v1" },
    "type": { "const": "resolution" },
    "id": { "type": "string", "minLength": 4 },
    "signature": { "type": "string", "pattern": "^rsig_[0-9a-fA-F]{64}$" },
    "algorithm": { "const": "ordered-three-way-blobs/v1" },
    "base": { "$ref": "#/$defs/stage" },
    "ours": { "$ref": "#/$defs/stage" },
    "theirs": { "$ref": "#/$defs/stage" },
    "resultBlob": {
      "description": "Resolved blob OID, or null when the resolution deletes the path.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    },
    "resultMode": { "type": ["string", "null"] },
    "originalPath": { "type": ["string", "null"] },
    "originatingApplication": { "type": "string", "minLength": 1 },
    "originatingCommit": { "$ref": "#/$defs/oid" },
    "originatingChangeId": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "ref": {
      "type": "string",
      "pattern": "^refs/vcs-lab/resolutions/",
      "description": "The retention ref that keeps the resolution commit reachable."
    },
    "resolutionCommit": {
      "$ref": "#/$defs/oid",
      "description": "The commit this record is attached to; when the record carries attachedTo, both must be equal."
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "attachedTo": { "$ref": "#/$defs/oid" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" },
    "stage": {
      "type": ["object", "null"],
      "required": ["mode", "blob"],
      "properties": {
        "mode": { "type": "string" },
        "blob": { "$ref": "#/$defs/oid" }
      }
    }
  }
}
