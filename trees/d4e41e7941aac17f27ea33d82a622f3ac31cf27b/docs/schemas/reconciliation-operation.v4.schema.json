{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.reconciliation-operation/v4",
  "title": "Reconciliation operation journal",
  "description": "Private resumable reconciliation journal, stored worktree-private at .git/vcs-lab/reconciliation.json while an operation is in progress (src/operations.js startOperation).",
  "x-vcs-lab-scope": "worktree-private",
  "type": "object",
  "required": [
    "schema",
    "id",
    "state",
    "worktree",
    "sourceRef",
    "sourceHead",
    "targetBefore",
    "acceptCandidates",
    "forecastId",
    "forecastApproval",
    "plan",
    "queue",
    "nextIndex",
    "applied",
    "current",
    "startedAt",
    "timings",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "vcs-lab.reconciliation-operation/v4"
    },
    "id": {
      "type": "string",
      "pattern": "^reconcile_op_[a-z0-9]+$"
    },
    "state": {
      "type": "string",
      "description": "'running', 'applying', 'conflicted', 'blocked', 'reducing-overlay', or 'forecast-mismatch'. 'reducing-overlay' is the moment before the first pick when the worktree is being returned to the committed head, with the overlay already safe in its checkpoint (ADR-0028)."
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceHead": {
      "$ref": "#/$defs/oid"
    },
    "targetBefore": {
      "$ref": "#/$defs/oid"
    },
    "targetBranchRef": {
      "type": [
        "string",
        "null"
      ],
      "description": "The symbolic ref HEAD pointed at when the operation started (null for a detached HEAD). Continue and abort refuse a worktree on any other branch, because abort restores targetBefore with a hard reset of whatever HEAD points at. Optional: journals written before v0.13.2 lack it and are trusted only while Git still holds the pick they are paused on."
    },
    "acceptCandidates": {
      "type": "boolean"
    },
    "forecastId": {
      "type": [
        "string",
        "null"
      ]
    },
    "forecastApproval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "planFingerprint",
        "approvedResolutions",
        "approvedSpecMerges",
        "status",
        "predictedResultTree"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "planFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "approvedResolutions": {
          "type": "array"
        },
        "approvedSpecMerges": {
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "predictedResultTree": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        }
      }
    },
    "plan": {
      "$ref": "vcs-lab.merge-plan/v1"
    },
    "queue": {
      "type": "array",
      "description": "The plan changes with status 'new', in application order.",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "changeId",
          "status"
        ]
      }
    },
    "nextIndex": {
      "type": "integer",
      "minimum": 0
    },
    "applied": {
      "type": "array",
      "items": {
        "$ref": "vcs-lab.application/v4"
      }
    },
    "current": {
      "$ref": "#/$defs/currentChange"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "timings": {
      "type": "object",
      "required": [
        "activeApplicationMs",
        "git"
      ],
      "properties": {
        "activeApplicationMs": {
          "type": "number"
        },
        "git": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetOverlay": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "checkpoint",
        "tree",
        "baseHead",
        "draftChangeId"
      ],
      "description": "The target overlay this forecast approves: uncommitted work a target workspace captured in a checkpoint, carried through the application and put back afterwards (ADR-0028). It is identified by the checkpoint commit rather than by the checkpoint ref, which moves when the next checkpoint is captured. Null, or absent, when no overlay is in play. Recorded in the journal so an abort can put the captured worktree back, and so a resumed operation in a new process knows an overlay is in play.",
      "properties": {
        "checkpoint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        },
        "baseHead": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        },
        "draftChangeId": {
          "type": "string",
          "pattern": "^draft_[0-9a-f]{64}$",
          "description": "Display and audit only. It is not a plan entry, not a coverage input, and not a receipt subject: a receipt claims nothing about an uncommitted state."
        },
        "workspaceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "rematerialized": {
          "type": [
            "string",
            "null"
          ],
          "description": "Always 'uncommitted': the overlay never enters committed history through this path."
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
    },
    "currentChange": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "sourceCommit",
        "sourceChangeId",
        "targetBefore",
        "conflictedPaths",
        "startedAt"
      ],
      "properties": {
        "sourceCommit": {
          "$ref": "#/$defs/oid"
        },
        "sourceChangeId": {
          "type": "string",
          "minLength": 1
        },
        "targetBefore": {
          "$ref": "#/$defs/oid"
        },
        "conflictedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array"
        },
        "gitOutput": {
          "type": "string"
        },
        "resolutionOutcomes": {
          "type": "array"
        },
        "semanticMerges": {
          "type": "array"
        },
        "forkChangeId": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
