{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.metadata-export/v1",
  "title": "Metadata export result",
  "description": "Result and process/storage metrics of vlab metadata export --json (CLI output; src/metadata-transfer.js exportMetadata).",
  "x-vcs-lab-scope": "cli-output",
  "type": "object",
  "required": [
    "schema", "path", "manifest", "payload", "records", "refs",
    "quarantinedRecords", "bytes", "git", "trust"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.metadata-export/v1" },
    "path": { "type": "string", "minLength": 1 },
    "manifest": { "type": "string", "minLength": 1 },
    "payload": {
      "type": ["string", "null"],
      "description": "Path of objects.bundle, or null when nothing portable existed to bundle."
    },
    "records": { "type": "integer", "minimum": 0 },
    "refs": { "type": "integer", "minimum": 0 },
    "quarantinedRecords": { "type": "integer", "minimum": 0 },
    "bytes": { "type": "integer", "minimum": 0 },
    "git": { "$ref": "vcs-lab.forecast/v2#/$defs/gitMetrics" },
    "trust": {
      "type": "object",
      "required": ["cryptographicallySigned", "authorized", "statement"],
      "properties": {
        "cryptographicallySigned": { "const": false },
        "authorized": { "const": false },
        "statement": { "type": "string" }
      }
    }
  }
}
