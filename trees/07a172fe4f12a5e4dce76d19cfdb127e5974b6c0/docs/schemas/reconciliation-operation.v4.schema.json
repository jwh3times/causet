{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcs-lab.reconciliation-operation/v4",
  "title": "Reconciliation operation journal",
  "description": "Private resumable reconciliation journal, stored worktree-private at .git/vcs-lab/reconciliation.json while an operation is in progress (src/operations.js startOperation).",
  "x-vcs-lab-scope": "worktree-private",
  "type": "object",
  "required": [
    "schema", "id", "state", "worktree", "sourceRef", "sourceHead",
    "targetBefore", "acceptCandidates", "forecastId", "forecastApproval",
    "plan", "queue", "nextIndex", "applied", "current", "startedAt",
    "timings", "updatedAt"
  ],
  "properties": {
    "schema": { "const": "vcs-lab.reconciliation-operation/v4" },
    "id": { "type": "string", "pattern": "^reconcile_op_[a-z0-9]+$" },
    "state": {
      "type": "string",
      "description": "'running', 'applying', 'conflicted', 'blocked', or 'forecast-mismatch'."
    },
    "worktree": { "type": "string", "minLength": 1 },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceHead": { "$ref": "#/$defs/oid" },
    "targetBefore": { "$ref": "#/$defs/oid" },
    "targetBranchRef": {
      "type": ["string", "null"],
      "description": "The symbolic ref HEAD pointed at when the operation started (null for a detached HEAD). Continue and abort refuse a worktree on any other branch, because abort restores targetBefore with a hard reset of whatever HEAD points at. Optional: journals written before v0.13.2 lack it and are trusted only while Git still holds the pick they are paused on."
    },
    "acceptCandidates": { "type": "boolean" },
    "forecastId": { "type": ["string", "null"] },
    "forecastApproval": {
      "type": ["object", "null"],
      "required": [
        "id", "planFingerprint", "approvedResolutions", "approvedSpecMerges",
        "status", "predictedResultTree"
      ],
      "properties": {
        "id": { "type": "string" },
        "planFingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "approvedResolutions": { "type": "array" },
        "approvedSpecMerges": { "type": "array" },
        "status": { "type": "string" },
        "predictedResultTree": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
        }
      }
    },
    "plan": { "$ref": "vcs-lab.merge-plan/v1" },
    "queue": {
      "type": "array",
      "description": "The plan changes with status 'new', in application order.",
      "items": { "type": "object", "required": ["commit", "changeId", "status"] }
    },
    "nextIndex": { "type": "integer", "minimum": 0 },
    "applied": {
      "type": "array",
      "items": { "$ref": "vcs-lab.application/v4" }
    },
    "current": { "$ref": "#/$defs/currentChange" },
    "startedAt": { "type": "string", "format": "date-time" },
    "timings": {
      "type": "object",
      "required": ["activeApplicationMs", "git"],
      "properties": {
        "activeApplicationMs": { "type": "number" },
        "git": { "type": ["object", "null"] }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" },
    "currentChange": {
      "type": ["object", "null"],
      "required": ["sourceCommit", "sourceChangeId", "targetBefore", "conflictedPaths", "startedAt"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "sourceChangeId": { "type": "string", "minLength": 1 },
        "targetBefore": { "$ref": "#/$defs/oid" },
        "conflictedPaths": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array" },
        "gitOutput": { "type": "string" },
        "resolutionOutcomes": { "type": "array" },
        "semanticMerges": { "type": "array" },
        "forkChangeId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
