{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causet.workspaces/v1",
  "title": "Workspace registry",
  "description": "Shared-local workspace registry container, stored at <common Git dir>/vcs-lab/workspaces.json (src/workspaces.js).",
  "x-causet-scope": "shared-local",
  "type": "object",
  "required": ["schema", "workspaces"],
  "properties": {
    "schema": { "enum": ["causet.workspaces/v1", "vcs-lab.workspaces/v1"] },
    "workspaces": {
      "type": "array",
      "items": { "$ref": "causet.workspace/v1" }
    }
  }
}
